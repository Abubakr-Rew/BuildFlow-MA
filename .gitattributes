# Text files are stored and checked out with LF on every OS,
# regardless of the local core.autocrlf setting.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never convert line endings or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
*.so binary
*.dll binary
*.exe binary
*.zip binary
*.pdf binary
